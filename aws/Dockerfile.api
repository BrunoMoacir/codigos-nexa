FROM python:3.12-slim

# Variáveis de ambiente exclusivas da API
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SCHEDULER_ENABLED=false \
    ROLE=api

WORKDIR /app/backend

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar dependências Python
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r /tmp/requirements.txt

# Copiar código da aplicação
COPY backend/ /app/backend/

# Script de inicialização (apenas Uvicorn, sem rodar jobs)
COPY <<'EOF' /app/start.sh
#!/bin/bash
set -e

echo "=========================================="
echo "🚀 NEXA API - AWS ECS/FARGATE STARTUP"
echo "=========================================="
echo ""

# Aplicar migrações (se for a instância master ou via pipeline, mas deixamos aqui como fallback)
alembic upgrade head || echo "Migrações pularam ou falharam, continuando..."

echo "🌟 Starting Uvicorn server (API ONLY)..."
# Usa WEB_CONCURRENCY na AWS (ex: Fargate com 2vCPUs -> WEB_CONCURRENCY=2)
exec uvicorn app.main:app \
    --host 0.0.0.0 \
    --port ${PORT:-8000} \
    --workers ${WEB_CONCURRENCY:-2} \
    --log-level info \
    --access-log
EOF

RUN chmod +x /app/start.sh

EXPOSE ${PORT:-8000}

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

CMD ["/app/start.sh"]
