<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (APNs). Troque para "production" no build da App Store (ou deixe o Xcode gerenciar). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Keychain compartilhado com a extensão do widget (credencial de escopo restrito). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)br.com.hive.app.compartilhado</string>
	</array>
</dict>
</plist>
