# Base da API. Relativo (/api/v1) = mesma origem: o Vite (dev) e o nginx
# (produção) encaminham ao backend. Absoluto só se o backend tiver CORS
# liberado para a origem do frontend.
VITE_API_URL=/api/v1

# Só em `npm run dev`: para onde o proxy do Vite encaminha /api.
VITE_DEV_BACKEND=http://localhost:8000
