<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada do app vai para o backup na nuvem nem para a transferência
     entre aparelhos — a sessão (tokens no armazenamento do WebView) e o cofre do
     widget ficam só neste aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
