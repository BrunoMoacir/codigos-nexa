<?xml version="1.0" encoding="utf-8"?>
<!-- Só HTTPS, com as autoridades certificadoras do sistema (nunca as do usuário). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
