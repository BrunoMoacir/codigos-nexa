# Copy to .env for local/dev (do NOT commit .env)
# NUNCA coloque valores reais neste arquivo — ele é versionado no git.

# Pluggy (optional for most endpoints)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# Segredo dos webhooks da Pluggy (→ /transactions/webhook e /pluggy/webhook).
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Em produção, webhook sem este segredo é recusado (fail-closed).
# No painel da Pluggy configure a URL como:
#   https://<host>/api/v1/pluggy/webhook?token=<PLUGGY_WEBHOOK_SECRET>
PLUGGY_WEBHOOK_SECRET=

# Webhook item/* dispara um sync sozinho quando não há nenhum em andamento
# (usuário conectou o banco e fechou o app). false = sync só sob demanda.
PLUGGY_AUTOSYNC_ON_WEBHOOK=true

# Sync incremental: dias ANTES da última transação salva que o sync relê a
# cada rodada (pega PENDING→POSTED e lançamento retroativo). Reler é upsert,
# não duplica. 0 = sempre extrato completo (mais caro, retroatividade ilimitada).
PLUGGY_SYNC_LOOKBACK_DAYS=7

# LLMs (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Database (Postgres if using docker-compose)
DATABASE_URL=postgresql+psycopg2://nexa_user:nexa_secret@localhost:5432/nexa_db

# Backend
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_prod
FRONTEND_BASE_URL=http://localhost:8501

# Web Push (PWA). Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:noreply@nexa.app
