# Segredos — NUNCA versionar (.env raiz esteve tracked com chave real
# até a auditoria de 2026-07-12; após `git rm --cached .env` esta regra
# impede reincidência). Os *.example ficam versionados como modelo.
.env
**/.env
.env.local
.env.*.local
!.env.example
!**/.env.example
!.env.railway.example
!frontend-react/.env.development

# Python virtual environment
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# DuckDB (gerados em runtime, não versionar)
*.duckdb
# Exceção: fixture de testes (pequena, gerada pelo seed, pode ser commitada)
!backend/tests/data/transactions.duckdb

# Data files gerados
data/
backend/data/*.duckdb
backend/data/*.csv
backend/data/*.parquet

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDEs
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
**/.DS_Store

# Logs
*.log
logs/
.env # se ainda não estiver lá

# Artefatos de runtime da inteligência (gerados por jobs; não versionar)
backend/data/negotiator_calibration.json
backend/evals/last_report.json
