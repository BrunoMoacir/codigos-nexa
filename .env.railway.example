# Variáveis de Ambiente para Railway
# Copie estas variáveis para o dashboard do Railway

# ==========================================
# OBRIGATÓRIAS
# ==========================================

# Banco de Dados (preenchido automaticamente pelo Railway se você adicionar PostgreSQL)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Secret Key (IMPORTANTE: gere uma chave forte!)
# Use: openssl rand -hex 32
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI

# Ambiente
APP_ENV=production
LOG_LEVEL=INFO

# ==========================================
# OPCIONAIS (APIs Externas)
# ==========================================

# Pluggy (Open Banking)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# ==========================================
# LLMs (escolha um)
# ==========================================

# OpenAI (recomendado para começar)
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OU Anthropic (Claude)
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-haiku-20240307

# ==========================================
# FRONTEND
# ==========================================

# URL do frontend (ajustar após deploy do frontend)
FRONTEND_BASE_URL=http://localhost:3000
# Origens que podem chamar a API (obrigatório em APP_ENV=production).
# Com o app nativo, inclua as origens do WebView (a API não usa cookie, então
# isso não abre credencial nenhuma — ver docs/APP_NATIVO.md):
#   ALLOWED_ORIGINS=https://SEU-FRONTEND.up.railway.app,https://localhost,capacitor://localhost
ALLOWED_ORIGINS=https://SEU-FRONTEND.up.railway.app

# ==========================================
# COBRANÇA (Stripe) — roteiro em docs/STRIPE_GO_LIVE.md
# ==========================================
# Segredos: cole direto no dashboard do Railway, nunca no Git.
# STRIPE_SECRET_KEY=rk_live_...            # restricted key (ver o roteiro)
# STRIPE_WEBHOOK_SECRET=whsec_...          # impresso UMA vez pelo scripts/stripe_setup.py
# STRIPE_PORTAL_CONFIGURATION=bpc_...
# STRIPE_API_VERSION=2024-06-20
# Só depois de uma assinatura de teste de ponta a ponta:
BILLING_ENFORCEMENT_ENABLED=false

# ==========================================
# PUSH DO APP NATIVO (Firebase Cloud Messaging)
# ==========================================
# FCM_SERVICE_ACCOUNT_B64=...              # segredo — conta de serviço em base64

# ── Serviço do frontend (imagem nginx de frontend-react/Dockerfile) ──
# O bundle chama /api/v1 relativo e o nginx encaminha para BACKEND_URL.
# BACKEND_URL=https://SEU-BACKEND.up.railway.app
# NGINX_RESOLVER=8.8.8.8   # fora do Docker local não existe o DNS 127.0.0.11

# ==========================================
# REDIS (Opcional)
# ==========================================

# Se adicionar Redis no Railway, descomente:
# REDIS_URL=${{Redis.REDIS_URL}}

# ==========================================
# DICAS
# ==========================================
#
# 1. Para gerar SECRET_KEY forte:
#    openssl rand -hex 32
#
# 2. No Railway, use a sintaxe ${{ServiceName.VARIABLE}}
#    para referenciar variáveis de outros serviços
#
# 3. Variáveis sensíveis (API keys) devem ser adicionadas
#    diretamente no dashboard, NÃO commitadas no Git
#
# 4. O Railway suporta variáveis por ambiente (dev, prod)
#
