# Variáveis de Ambiente para Railway
# Copie estas variáveis para o dashboard do Railway

# ==========================================
# OBRIGATÓRIAS
# ==========================================

# Banco de Dados (preenchido automaticamente pelo Railway se você adicionar PostgreSQL)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Secret Key (IMPORTANTE: gere uma chave forte!)
# Use: openssl rand -hex 32
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI

# Ambiente
APP_ENV=production
LOG_LEVEL=INFO

# ==========================================
# OPCIONAIS (APIs Externas)
# ==========================================

# Pluggy (Open Banking)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# ==========================================
# LLMs (escolha um)
# ==========================================

# OpenAI (recomendado para começar)
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OU Anthropic (Claude)
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-haiku-20240307

# ==========================================
# FRONTEND
# ==========================================

# URL do frontend (ajustar após deploy do frontend)
FRONTEND_BASE_URL=http://localhost:3000

# ==========================================
# REDIS (Opcional)
# ==========================================

# Se adicionar Redis no Railway, descomente:
# REDIS_URL=${{Redis.REDIS_URL}}

# ==========================================
# DICAS
# ==========================================
#
# 1. Para gerar SECRET_KEY forte:
#    openssl rand -hex 32
#
# 2. No Railway, use a sintaxe ${{ServiceName.VARIABLE}}
#    para referenciar variáveis de outros serviços
#
# 3. Variáveis sensíveis (API keys) devem ser adicionadas
#    diretamente no dashboard, NÃO commitadas no Git
#
# 4. O Railway suporta variáveis por ambiente (dev, prod)
#
