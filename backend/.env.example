# Copy to .env for local/dev (do NOT commit .env)
# NUNCA coloque valores reais neste arquivo — ele é versionado no git.

# Pluggy (optional for most endpoints)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# Segredo dos webhooks da Pluggy (→ /transactions/webhook e /pluggy/webhook).
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Em produção, webhook sem este segredo é recusado (fail-closed).
# No painel da Pluggy configure a URL como:
#   https://<host>/api/v1/pluggy/webhook?token=<PLUGGY_WEBHOOK_SECRET>
PLUGGY_WEBHOOK_SECRET=

# Webhook item/* dispara um sync sozinho quando não há nenhum em andamento
# (usuário conectou o banco e fechou o app). false = sync só sob demanda.
PLUGGY_AUTOSYNC_ON_WEBHOOK=true

# Sync incremental: dias ANTES da última transação salva que o sync relê a
# cada rodada (pega PENDING→POSTED e lançamento retroativo). Reler é upsert,
# não duplica. 0 = sempre extrato completo (mais caro, retroatividade ilimitada).
PLUGGY_SYNC_LOOKBACK_DAYS=7

# LLMs (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Database (Postgres if using docker-compose)
DATABASE_URL=postgresql+psycopg2://nexa_user:nexa_secret@localhost:5432/nexa_db

# Backend
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_in_prod
# App React (links de e-mail de verificação/reset e retorno do Stripe).
# Era 8501 (Streamlit), onde essas rotas não existem.
FRONTEND_BASE_URL=http://localhost:3000

# Web Push (PWA). Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:noreply@nexa.app

# Billing — Stripe (assinaturas Pro R$19,90 / Total R$39,90)
# Crie os Products/Prices no dashboard Stripe e cole os price ids abaixo.
# Webhook: configure o endpoint /api/v1/billing/webhook no dashboard e cole
# o signing secret (whsec_...). Em produção, webhook sem segredo é recusado.
# BILLING_ENFORCEMENT_ENABLED=false → dark launch (gating só loga, não bloqueia)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TOTAL_MONTHLY=
BILLING_ENFORCEMENT_ENABLED=false

# SERPRO — API Consulta Restituição IRPF (T3 consulta autorizada)
# Trial: SERPRO_RESTITUICAO_TRIAL=true usa o ambiente de demonstração público
# do SERPRO (sem credenciais). Produção: contrate na Loja SERPRO e preencha
# key/secret. A chave privada é o arquivo `chave-privada` do seu e-CNPJ
# (DER PKCS#8 já em base64) — decripta os campos da resposta.
SERPRO_RESTITUICAO_TRIAL=false
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_RESTITUICAO_PRIVATE_KEY_B64=
