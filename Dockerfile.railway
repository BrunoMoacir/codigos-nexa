FROM python:3.12-slim

# Variáveis de ambiente
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/backend

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar dependências Python
COPY backend/requirements.railway.txt /tmp/requirements.txt
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r /tmp/requirements.txt

# Copiar código da aplicação
COPY backend/ /app/backend/

# Script de inicialização
COPY <<'EOF' /app/start.sh
#!/bin/bash
set -e

echo "=========================================="
echo "🚀 NEXA API - RAILWAY STARTUP"
echo "=========================================="
echo ""

# Mostrar informações de ambiente
echo "📦 Python version: $(python --version)"
echo "🌍 APP_ENV: ${APP_ENV:-not set}"
echo "🔗 DATABASE_URL: $(if [ -n "$DATABASE_URL" ]; then echo "✅ configured"; else echo "❌ NOT SET"; fi)"
echo "🔑 SECRET_KEY: $(if [ -n "$SECRET_KEY" ]; then echo "✅ configured"; else echo "❌ NOT SET"; fi)"
echo "🤖 LLM_PROVIDER: ${LLM_PROVIDER:-not set}"
echo "🚪 PORT: ${PORT:-8000}"
echo ""

# Verificar se as variáveis críticas estão configuradas
if [ -z "$DATABASE_URL" ]; then
    echo "⚠️  WARNING: DATABASE_URL not set - database connections will fail"
fi

if [ -z "$SECRET_KEY" ]; then
    echo "⚠️  WARNING: SECRET_KEY not set - using default (INSECURE)"
fi

# Corrigir DATABASE_URL se necessário (Railway fornece postgresql:// mas precisamos postgresql+psycopg2://)
if [[ "$DATABASE_URL" == postgresql://* ]] && [[ "$DATABASE_URL" != *"+psycopg2://"* ]]; then
    export DATABASE_URL="${DATABASE_URL/postgresql:\/\//postgresql+psycopg2:\/\/}"
    echo "🔧 Fixed DATABASE_URL prefix to postgresql+psycopg2://"
fi

echo "=========================================="
echo "📊 Running database migrations..."
echo "=========================================="
echo ""

# Script Python para verificar estado das migrações
python3 << 'PYTHON_SCRIPT'
import sys
import os
from sqlalchemy import create_engine, text, inspect
from alembic.config import Config
from alembic import command

try:
    database_url = os.environ.get("DATABASE_URL")
    if not database_url:
        print("❌ DATABASE_URL não configurada")
        sys.exit(1)

    print(f"🔍 Conectando ao banco de dados...")
    engine = create_engine(database_url, echo=False)

    with engine.connect() as conn:
        inspector = inspect(engine)

        # Verificar se alembic_version existe
        has_alembic_version = inspector.has_table("alembic_version")

        # Verificar se as tabelas principais existem
        has_tables = (
            inspector.has_table("context_overrides") or
            inspector.has_table("transactions_clean") or
            inspector.has_table("health_score_history")
        )

        print(f"📋 Estado do banco:")
        print(f"   - Tabela alembic_version: {'✅ existe' if has_alembic_version else '❌ não existe'}")
        print(f"   - Tabelas do schema: {'✅ existem' if has_tables else '❌ não existem'}")

        alembic_cfg = Config("alembic.ini")

        if has_tables and not has_alembic_version:
            print("🔧 Tabelas existem mas alembic_version não. Marcando migrações como aplicadas...")
            command.stamp(alembic_cfg, "head")
            print("✅ Migrações marcadas como aplicadas (stamp)")
        elif not has_tables:
            print("🚀 Banco vazio. Aplicando todas as migrações...")
            command.upgrade(alembic_cfg, "head")
            print("✅ Migrações aplicadas com sucesso")
        else:
            print("🔄 Aplicando migrações pendentes (se houver)...")
            command.upgrade(alembic_cfg, "head")
            print("✅ Banco atualizado")

    print("✅ Migração concluída com sucesso")
    sys.exit(0)

except Exception as e:
    print(f"❌ Erro nas migrações: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)
PYTHON_SCRIPT

if [ $? -ne 0 ]; then
    echo "❌ Falha nas migrações do banco de dados"
    exit 1
fi

echo ""
echo "=========================================="
echo "🌟 Starting Uvicorn server..."
echo "=========================================="
echo ""

# Iniciar uvicorn
exec uvicorn app.main:app \
    --host 0.0.0.0 \
    --port ${PORT:-8000} \
    --log-level info \
    --access-log
EOF

RUN chmod +x /app/start.sh

# Expor porta
EXPOSE ${PORT:-8000}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Comando de inicialização
CMD ["/app/start.sh"]
